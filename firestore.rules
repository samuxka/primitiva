rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Regra padrão: Bloqueia absolutamente tudo que não estiver listado abaixo
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Mensagens de Contato:
    // Qualquer pessoa na internet pode enviar (create).
    // Somente o Admin autenticado pode ler (read), editar ou deletar.
    match /contacts/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // 3. Artigos do Blog (studies):
    // Leitura é pública. Criação e deleção são restritas ao admin.
    // Para atualizar: O Admin pode alterar tudo. O usuário comum SÓ pode atualizar o contador de likes (likes_count).
    match /studies/{document} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes_count']) && request.resource.data.likes_count == resource.data.likes_count + 1);
    }

    // 4. Missões: 
    // Leitura pública.
    // Atenção: O arquivo MissionsContext.tsx atualiza o campo "raised" quando alguém
    // simula uma doação no site, por isso precisamos liberar o 'update' público.
    // A deleção fica apenas para o Admin.
    match /missions/{document} {
      allow read: if true;
      allow create, update: if true; 
      allow delete: if request.auth != null;
    }

    // 5. Balanços de Transparência (transactions): 
    // Leitura pública.
    // Atenção: O arquivo MissionsContext.tsx cria uma transação automaticamente
    // quando alguém simula uma doação. Logo, precisamos liberar o 'create' público.
    match /transactions/{document} {
      allow read: if true;
      allow create: if true; 
      allow update, delete: if request.auth != null;
    }

    // 6. Galeria de Álbuns (corrigido nomes das coleções baseadas no código):
    // Leitura pública. Escrita somente admin.
    match /gallery/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /albums_meta/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
